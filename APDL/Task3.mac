FINISH
/CLEAR, START
/TITLE, Task3

!参数设置和定义

!材料参数定义
E_val = 2.06e5 !弹性模量
nu_val = 0.3  !泊松比
rho_val = 7.85e-9 !密度

!板架总体的尺度参数
n_long = 3 !交叉构件数量
n_rib =5 !主向梁数量
s_long = 1600 !交叉构件之间间距
s_rib = 1200 !主向梁之间间距
long_ext = s_rib !交叉构件单侧外伸长度
rib_ext = s_long/2 !主向梁单侧外伸长度

!每根骨架参数
t_plate = 10 !等效带板厚度
b_eq_plate_long = 200 !交叉构件等效带板宽度 min(1600/2, 1200/6)=200
b_eq_plate_rib = 266.666666667 !主向梁等效带板宽度 min(1600/6, 1200/2)=266.667
t_eq_plate = t_plate !下翼缘作为等效带板

h_web_L1 = 400 !中间交叉构件腹板高度
t_web_L1 = 7 !中间交叉构件腹板厚度
b_bot_L1 = 170 !自由翼缘宽度
t_bot_L1 = 15 !自由翼缘厚度

h_web_L2 = 400 !两侧交叉构件腹板高度
t_web_L2 = 7 !两侧交叉构件腹板厚度
b_bot_L2 = 170 !自由翼缘宽度
t_bot_L2 = 15 !自由翼缘厚度

h_web_R1 = 210 !主向梁腹板高度
t_web_R1 = 6 !主向梁腹板厚度
b_bot_R1 = 150 !主向梁自由翼缘宽度
t_bot_R1 = 14 !主向梁自由翼缘厚度

!载荷及许用约束
q1 = 18 !载荷施加在主向梁上
sigma_allow = 135 !许用应力
bend_allow = 81 !弯应力0.6倍
shear_allow = 40.5 !剪应力0.3倍

n_div = 20 !纵骨单元分割数
n_div_rib = 5 !横骨单元分割数

L_span = (n_rib-1)*s_rib !沿主向梁方向跨度
W_span = (n_long-1)*s_long !沿交叉构件方向跨度
X_left = -long_ext
X_right = L_span + long_ext
Y_bottom = -rib_ext
Y_top = rib_ext+W_span

h_total_L1 = t_bot_L1 + h_web_L1 + t_eq_plate !中间交叉构件总高
h_total_L2 = t_bot_L2 + h_web_L2 + t_eq_plate !两侧交叉构件总高
h_total_R1 = t_bot_R1 + h_web_R1 + t_eq_plate !中间主向梁总高
L_long_beam = L_span + 2*long_ext !结构总长
L_rib_beam = W_span + 2*rib_ext !结构总宽

/PREP7 !前处理

ET, 1, BEAM188

KEYOPT, 1, 4, 2

MP, EX, 1, E_val
MP, PRXY, 1, nu_val
MP, DENS, 1, rho_val

! 长翼缘(W2/t2)表示等效带板，截面对齐保持 ANSYS 默认设置。
SECTYPE, 1, BEAM, I, LONG_C, 5 !中间交叉构件
SECDATA, b_bot_L1, b_eq_plate_long, h_total_L1, t_bot_L1, t_eq_plate, t_web_L1
SECTYPE, 2, BEAM,  I, LONG_S, 5 !两侧交叉构件
SECDATA, b_bot_L2, b_eq_plate_long, h_total_L2, t_bot_L2, t_eq_plate, t_web_L2
SECTYPE, 3, BEAM, I, RIB, 5
SECDATA, b_bot_R1, b_eq_plate_rib, h_total_R1, t_bot_R1, t_eq_plate, t_web_R1

K, 1, X_left, 0, 0
K, 2, 0, 0, 0
K, 3, s_rib, 0, 0
K, 4, 2*s_rib, 0, 0
K, 5, 3*s_rib, 0, 0
K, 6, 4*s_rib, 0, 0
