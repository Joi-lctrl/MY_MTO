K, 120, 4*s_rib, Y_top, -1000

LSEL, S, LINE, , 1, 6
LATT, 1, , 1, , 101, , 2
LESIZE, ALL, , , n_div

LSEL, S, LINE, , 7, 12
LATT, 1, , 1, , 103, , 1
LESIZE, ALL, , , n_div

LSEL, S, LINE, , 13, 18
LATT, 1, , 1, , 105, , 2
