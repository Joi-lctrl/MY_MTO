ALLSEL, ALL
LMESH, ALL
ALLSEL, ALL

!边界条件
ALLSEL, ALL

NSEL, S, LOC, X, X_left
D, ALL, UX, 0
D, ALL, UY, 0
D, ALL, UZ, 0
D, ALL, ROTX, 0
D, ALL, ROTY, 0
D, ALL, ROTZ, 0

ALLSEL, ALL

NSEL, S, LOC, X, X_right
D, ALL, UX, 0
