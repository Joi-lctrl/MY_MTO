*VWRITE, sx_min
(F20.6)
*VWRITE, sxy_max
(F20.6)
*VWRITE, sxy_min
(F20.6)
*VWRITE, sxz_max
(F20.6)
*VWRITE, sxz_min
(F20.6)

! Total structural mass from FEA model
ALLSEL, ALL
*GET, total_mass, ELEM, 0, MTOT, Z
